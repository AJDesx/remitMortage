{
  "version": 1,
  "description": "Frontend consumer expectations for endpoints used by the application UI.",
  "endpoints": [
    { "method": "get", "path": "/api/analytics/overview", "responses": [200], "consumer": "frontend/src/app/analytics/page.tsx" },
    { "method": "post", "path": "/api/verification/check", "responses": [200, 400], "consumer": "frontend/src/app/verify/page.tsx" },
    { "method": "post", "path": "/api/verification/challenge", "responses": [200, 400], "consumer": "frontend/src/components/onboarding/OnboardingWizard.tsx" },
    { "method": "post", "path": "/api/kyc/{address}/upload", "responses": [201, 400, 403], "consumer": "frontend/src/components/onboarding/DocumentChecklist.tsx" },
    { "method": "post", "path": "/api/admin/loans/bulk-review", "responses": [200, 400], "consumer": "frontend/src/app/admin/page.tsx" }
  ]
}
